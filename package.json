{
  "name": "nishchay_sih",
  "version": "1.0.0",
  "description": "Prototype for SIH26036",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development tsx watch server/server.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build": "vite build -c web/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx server/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json && tsc -p shared/tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "test:watch": "vitest",
    "verify": "node scripts/check-encoding.mjs && npm run lint && npm run typecheck && npm run test && npm run build",
    "demo:setup": "tsx server/scripts/demo-setup.ts",
    "demo:reset": "tsx server/scripts/demo-reset.ts",
    "preflight": "tsx server/scripts/preflight.ts",
    "shots": "playwright test tests/shots.spec.ts",
    "keygen": "tsx server/scripts/keygen.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/source-sans-3": "^5.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.56.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.445.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.7",
    "vitest": "^2.1.1"
  }
}